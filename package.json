{
  "name": "weread-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/free-port.js 8787 && tsx watch server/src/index.ts",
    "dev:web": "node scripts/free-port.js 5173 && vite serve web --port 5173",
    "build": "tsc -p server --noEmit && tsc -p web --noEmit && vite build web",
    "check:reading": "tsx scripts/check-reading-baseline.ts",
    "preview": "vite preview web"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
